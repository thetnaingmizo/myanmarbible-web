{
  "name": "myanmarbible-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:gen-types": "npx supabase gen types typescript --local 2>/dev/null > src/types/database.ts",
    "db:seed-bible": "npx tsx scripts/seed-bible/index.ts",
    "db:seed-bible:judson": "npx tsx scripts/seed-bible/index.ts --only judson",
    "db:seed-bible:kjv": "npx tsx scripts/seed-bible/index.ts --only kjv",
    "db:seed-bible:mizo": "npx tsx scripts/seed-bible/index.ts --only mizo",
    "db:seed-bible:download": "npx tsx scripts/seed-bible/index.ts --download-only",
    "db:seed-bible:verify": "npx tsx scripts/seed-bible/verify.ts",
    "db:seed-characters": "npx tsx scripts/seed-characters/seed.ts",
    "db:seed-lessons": "npx tsx scripts/seed-lessons/seed.ts",
    "db:seed-blog": "npx tsx scripts/seed-blog/seed.ts",
    "db:seed-podcast": "npx tsx scripts/seed-podcast/seed.ts",
    "db:seed-questions": "npx tsx scripts/seed-questions/seed.ts",
    "db:generate-embeddings": "npx tsx scripts/generate-embeddings.ts",
    "db:generate-embeddings:judson": "npx tsx scripts/generate-embeddings.ts --only judson",
    "db:generate-embeddings:kjv": "npx tsx scripts/generate-embeddings.ts --only kjv"
  },
  "dependencies": {
    "@google/genai": "^1.41.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "next-intl": "^4.8.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.61.1",
    "shadcn": "^3.8.4",
    "supabase": "^2.76.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
