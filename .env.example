# Supabase — modern API keys (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy JWT-based keys still work as fallbacks if the above are unset:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# AI (chat / verse finder / embeddings)
GEMINI_API_KEY=

# Public site URL (used for the Google sign-in callback). Falls back to the request host.
NEXT_PUBLIC_APP_URL=http://localhost:3000
